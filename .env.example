# knitstudio deployment environment
# Copy to .env and customize

# Database
DB_USER=knitstudio
DB_PASSWORD=knitstudio
DB_NAME=knitstudio
DB_PORT=5432

# Redis
REDIS_PORT=6379

# Security (CHANGE THESE IN PRODUCTION)
JWT_SECRET=knitstudio-prod-change-me
KEYSTORE_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Portainer
PORTAINER_PORT=9000

# Builder
BUILDER_PORT=3000

# API
API_PORT=3001

# MCP Server
MCP_PORT=3100
